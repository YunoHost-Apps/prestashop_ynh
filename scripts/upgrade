#!/bin/bash

source /usr/share/yunohost/helpers

#=================================================
# ENSURE DOWNWARD COMPATIBILITY
#=================================================
ynh_script_progression "Ensuring downward compatibility..."

ynh_app_setting_set_default --key=php_upload_max_filesize --value=1G
ynh_app_setting_set_default --key=php_memory_limit --value=512M
ynh_app_setting_set_default --key=php_max_execution_time --value=60

#=================================================
# Upgrade Prestashop
#=================================================
pushd "$install_dir"
  admin_dir=$(ls | grep admin)
  ynh_script_progression "Install autoupgrade module..."
  php $install_dir/bin/console prestashop:module install autoupgrade
  ynh_script_progression "upgrade..."
  php $install_dir/modules/autoupgrade/bin/console update:start --channel=online $admin_dir
popd

#=================================================
# REAPPLY SYSTEM CONFIGURATIONS
#=================================================
ynh_script_progression "Upgrading system configurations related to $app..."

ynh_config_add_phpfpm

ynh_config_add_nginx

#=================================================
# PHP-FPM CONFIGURATION
#=================================================
# ynh_script_progression "Upgrading database..."

# pushd $install_dir
# 	php$php_version ./install/upgrade/upgrade.php
# popd

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Upgrade of $app completed"
