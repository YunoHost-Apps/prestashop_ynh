#!/bin/bash

source /usr/share/yunohost/helpers

#=================================================
# INITIALIZE AND STORE SETTINGS
#=================================================

ynh_app_setting_set_default --key=php_upload_max_filesize --value=1G
ynh_app_setting_set_default --key=php_memory_limit --value=512M
ynh_app_setting_set_default --key=php_max_execution_time --value=60

#=================================================
# DOWNLOAD, CHECK AND UNPACK SOURCE
#=================================================
ynh_script_progression "Setting up source files..."

ynh_setup_source --dest_dir="$install_dir"

#=================================================
# Install Prestashop
#=================================================
ynh_script_progression "Install Composer dependencies..."
ynh_composer_exec install --no-dev

ynh_script_progression "Install hummingbird theme..."
ynh_setup_source --dest_dir="$install_dir/themes/hummingbird/" --source_id=hummingbird

ynh_script_progression "Install Prestashop..."
cd "$install_dir"
ynh_exec_as_app php${php_version} $install_dir/install-dev/index_cli.php --domain=$domain --db_server=localhost --db_name=$db_name --db_user=$db_user --db_password=$db_pwd
ynh_safe_rm $install_dir/install-dev
ynh_safe_rm $install_dir/Install_PrestaShop.html
admin_dir=$(ls | grep admin | grep -ve admin-api)
ynh_app_setting_set --key=admin_dir --value=$admin_dir

#=================================================
# SYSTEM CONFIGURATION
#=================================================
ynh_script_progression "Adding system configurations related to $app..."

ynh_config_add_phpfpm

ynh_config_add_nginx

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Installation of $app completed"
